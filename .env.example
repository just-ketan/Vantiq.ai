# ===========================
# Application
# ===========================
APP_NAME=Vantiq.ai
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me

# ===========================
# Database
# ===========================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vantiq
POSTGRES_USER=vantiq
POSTGRES_PASSWORD=password

DATABASE_URL=postgresql+psycopg://vantiq:password@postgres:5432/vantiq

# ===========================
# JWT
# ===========================
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===========================
# Qdrant
# ===========================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=vantiq_documents

# ===========================
# Uploads
# ===========================
UPLOAD_STORAGE=local
UPLOAD_DIRECTORY=storage/uploads
MAX_UPLOAD_SIZE=104857600

# ===========================
# AI
# ===========================
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# ===========================
# Logging
# ===========================
LOG_LEVEL=INFO